# Neon: pooled URL for the app (node-postgres via @prisma/adapter-pg), direct URL for the Prisma CLI
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require&connect_timeout=15"

# Better Auth: secret (openssl rand -base64 32) and public URL of the app.
# On Vercel BETTER_AUTH_URL may be omitted: VERCEL_URL is used (see src/lib/auth.ts).
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Development only: `pnpm prisma db seed` creates one test user per role with this password
SEED_TEST_USERS="false"
SEED_TEST_PASSWORD=""
